# Telegram bot token from BotFather
BOT_TOKEN=123456789:your_bot_token_here

# Claude/Anthropic API key
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here

# Optional OpenAI-compatible API key for Whisper/audio transcription
OPENAI_API_KEY=
WHISPER_API_KEY=
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
WHISPER_MODEL=whisper-1

# Optional threat-intel and dark web provider keys
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
HIBP_API_KEY=
INTELLIGENCEX_API_KEY=
DEHASHED_API_KEY=
DEHASHED_EMAIL=
HUNTER_API_KEY=
URLSCAN_API_KEY=

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberguard

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# Comma-separated Telegram numeric user IDs for admins
ADMIN_IDS=123456789,987654321

# FastAPI backend URL used by the bot
BACKEND_URL=http://localhost:8000

# App runtime environment: development or production
ENVIRONMENT=development
